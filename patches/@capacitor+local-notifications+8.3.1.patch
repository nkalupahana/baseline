@@ -0,0 +1,33 @@
+package com.capacitorjs.plugins.localnotifications
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import com.getcapacitor.CapConfig
+
+/**
+ * Rearms `schedule.on` alarms after a timezone change. AlarmManager stores an
+ * absolute timestamp, so a clock-time reminder would otherwise fire at the old
+ * offset. Cancelled perpetual schedules are left alone so a timezone change
+ * cannot resurrect a reminder the user already cancelled.
+ */
+class LocalNotificationTimezoneReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != Intent.ACTION_TIMEZONE_CHANGED) return
+
+        val storage = NotificationStorage(context)
+        val toReschedule = ArrayList<LocalNotification>()
+        for (id in storage.getSavedNotificationIds()) {
+            val notification = storage.getSavedNotification(id) ?: continue
+            val schedule = notification.schedule ?: continue
+            if (schedule.on == null || notification.cancelled) continue
+            toReschedule.add(notification)
+        }
+        if (toReschedule.isEmpty()) return
+
+        val config = CapConfig.loadDefault(context)
+        val manager = LocalNotificationManager(storage, null, context, config)
+        manager.schedule(null, toReschedule)
+    }
+}
